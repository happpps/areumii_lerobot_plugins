# Optional shell settings. Load explicitly: set -a; source .env; set +a
# XR helpers and the default URDF now come from installed AReuMii-Teleop.
LEROBOT_VENV="$HOME/projects/env_lerobot"
# Optional custom model: AREUMII_URDF="/absolute/path/to/model.urdf"
# Deprecated source override, only for migration: AREUMII_TELEOP_PATH="/path/to/source"
# Desktop example: LEROBOT_VENV="$PWD/.venv"
# Authenticate with hf auth login; do not put credentials in this template.
